{
  "search.exclude": {
    "**/_site/**": true,
    "docs/_site/**": true,
    "docs/.jekyll-cache/**": true,
    ".notes/**": true,
    ".claude/worktrees/**": true,
    ".worktrees/**": true,
    "test-vault/**": true
  },
  "files.watcherExclude": {
    "**/_site/**": true,
    "docs/_site/**": true,
    ".notes/**": true,
    ".claude/worktrees/**": true,
    ".worktrees/**": true,
    "test-vault/**": true,
    "docs/.jekyll-cache/**": true
  },
  "shellcheck.customArgs": ["--severity=warning"],
  "powershell.scriptAnalysis.enable": true,
  "powershell.scriptAnalysis.settingsPath": "scripts/PSScriptAnalyzerSettings.psd1",
  "ruff.nativeServer": "on",
  "linter.linters": {
    "yamllint": {
      "enabled": true
    }
  },
  "markdownlint.enable": true,
  "markdownlint.config": {
    "extends": ".markdownlint.json",
    "MD013": {
      "line_length": 90,
      "headings": false,
      "code_blocks": false,
      "tables": false
    }
  },
  "editor.pasteAs.enabled": false,
  "markdown.editor.pasteUrlAsFormattedLink.enabled": "never",
  "markdown.editor.filePasteCopyIntoWorkspace": "never",
  "markdown.editor.drop.copyIntoWorkspace": "never",
  "[markdown]": {
    "editor.formatOnSave": false,
    "editor.codeActionsOnSave": {
      "source.fixAll.markdownlint": "explicit"
    }
  },
  "[plaintext]": {
    "editor.formatOnSave": false
  },
  "[python]": {
    "editor.formatOnSave": false
  },
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true
}
