#!/usr/bin/env python3
"""Run Memoria's single verification gate.

One flat gate, no tiers: lint (the pinned manual-stage pre-commit hooks), the
product-integrity checks, the test suite, an offline end-to-end smoke, and
syntax checks. Runs the roster in order, prints each step, skips (does not
fail) a check whose local tool is absent (e.g. PowerShell), and exits nonzero
on the first hard failure.

Docs-only narrowing (CI only): when `VERIFY_DOCS_ONLY=1`, the roster drops the
entries marked `docs=False` below — the gates a docs-only diff (Markdown outside
`src/` and/or files under `design-history/`) provably cannot affect — narrows
pytest to the `static` marker (schema, docs-refs, design-history, spell), and
skips the JSON and PowerShell syntax checks, which are not roster entries.
Markdown under `src/` is runtime package data and never qualifies for this
narrowing. CI sets it only for PRs whose whole diff is documentation; local runs
and the post-merge `main` run always execute the full roster.

Sharding (CI only): `--shard NAME` runs one leg of the roster, so CI can spend
four runners on a gate that is throughput-bound rather than dominated by any one
check. A bare `python scripts/verify` is unchanged and still runs everything —
the shards are a way to divide the same roster, not a second roster. What keeps
"CI verified" and "verified locally" the same claim is
`tests/test_verify_script.py`, which asserts the union of the shards reproduces
this roster exactly once and that `.github/workflows/verify.yml` runs every
declared shard. Before sharding, that equality rested on CI invoking the same
command string, and nothing checked it.

One run per checkout: the e2e smoke resets `<checkout>/test-vault` outright, so
a second concurrent gate destroys the first one's fixture mid-run. Only a run
that selects that gate takes the lock (`Gate.mutates_vault`), so shards without
it run side by side in one checkout. See `_hold_single_run_lock`.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]

# Per-checkout, so parallel worktrees still run their gates at the same time.
LOCK_PATH = ROOT / ".verify.lock"

# CI sets this to "1" only for provably docs-only PRs (see the module docstring).
DOCS_ONLY = os.environ.get("VERIFY_DOCS_ONLY") == "1"

# Every registered level marker except `live`, split across the test shards.
# `slow` is orthogonal — it grades speed within a level, so slow tests ride along
# with their level's disjunct. The split is by measured cost at four xdist
# workers (contract 41s, runtime 35s, the rest 42s together), not by meaning.
CONTRACT_MARKERS = "contract"
RUNTIME_MARKERS = "runtime"
SWEEP_MARKERS = "static or unit or package or floor"

# The shards CI runs as a matrix. A bare `python scripts/verify` runs all of them
# in roster order and is unchanged by their existence; the shards exist so CI can
# spend four runners on one roster. tests/test_verify_script.py asserts that the
# union of the shards is exactly this roster, which is what keeps "CI verified"
# and "verified locally" the same claim.
SHARDS = ("lint", "contract", "runtime", "sweep")

# 1733: N worktrees each taking `-n auto` = all cores thrash each other (same
# suite measured 190s at load ~3 vs 3,355s at load 18). Half the cores per run
# keeps two concurrent gates at parity with one greedy one; an explicit
# PYTEST_XDIST_AUTO_NUM_WORKERS in the environment still wins.
os.environ.setdefault("PYTEST_XDIST_AUTO_NUM_WORKERS", str(max(2, (os.cpu_count() or 4) // 2)))


@dataclass(frozen=True)
class Gate:
    """One verify step.

    `docs` is True unless a docs-only diff (Markdown outside `src/` and/or files
    under `design-history/`) provably cannot affect the step; False is the
    explicit opt-out that drops it under `VERIFY_DOCS_ONLY=1`, so a new entry
    that never considered docs scope still runs there.

    `shard` names which CI matrix leg runs the step. It defaults to `lint` so a
    new entry that never considered sharding still runs somewhere rather than
    falling out of the roster silently.

    `markers` is the pytest marker expression this step passes, when it is a
    pytest step. Held per gate rather than compared against one module constant,
    so the docs-only narrowing can rewrite the right gate once several carry
    markers.

    `mutates_vault` is True for a step that rewrites `<checkout>/test-vault`.
    Only a run selecting such a step needs the single-run lock, so two shards can
    run side by side in one checkout.
    """

    cmd: list[str]
    docs: bool = True
    shard: str = "lint"
    markers: str | None = None
    mutates_vault: bool = False
    manual_lint: bool = False


def _pytest_cmd(markers: str) -> list[str]:
    """The test gate's command for one marker expression.

    One builder rather than three copies: the flags below are load-bearing and
    drifting them per shard would make the shards test differently.
    """
    return [
        "env",
        "PYTEST_DISABLE_PLUGIN_AUTOLOAD=1",
        "python3",
        "-m",
        "pytest",
        "tests/",
        "-q",
        # Parallelize across cores (pytest-xdist); `-p xdist` because plugin
        # autoload is disabled above. The vault-mutating tests are I/O-bound and
        # per-test isolated (tmp_path), so this cuts the suite ~3x. `-m` stays
        # last so the docs-only narrowing can swap the marker for `static`.
        "-n",
        "auto",
        "-p",
        "xdist",
        # 1733: the default `--dist load` scatters a module's tests across
        # workers, so module-scoped fixtures (the ~30s seed_vault builds in
        # test_floor_sweep_reads / test_read_api_scope_walk) are rebuilt once
        # per worker. loadgroup pins only the xdist_group-marked modules to a
        # single worker each (one fixture build per file) while everything
        # else — notably test_floor_sweep_operations' 60 expensive tests —
        # keeps free load balancing; a blanket loadfile would serialize them.
        "--dist",
        "loadgroup",
        "-m",
        markers,
    ]


FULL_LINT_COMMAND = ["pre-commit", "run", "--hook-stage", "manual", "--all-files"]
DOCS_LINT_HOOKS = ("vale", "markdownlint-structural", "mermaid-parse", "cspell")
DOCS_LINT_COMMANDS = tuple(
    ["pre-commit", "run", hook, "--hook-stage", "manual", "--all-files"]
    for hook in DOCS_LINT_HOOKS
)


# Source of truth for what "verified" means; tests/test_verify_script.py mirrors
# this roster. Lint runs the manual-stage pre-commit hooks (ruff, ruff-format,
# yamllint, shellcheck, cspell, markdownlint); the commit-stage hooks
# (gitleaks, no-commit-to-branch) are pinned out of the manual stage so this
# never trips no-commit-to-branch on the post-merge main run.
GATES: list[Gate] = [
    Gate(FULL_LINT_COMMAND, manual_lint=True),
    Gate(["python3", "scripts/checks/schema_doc_drift.py"]),
    Gate(["python3", "scripts/checks/removed_surface_gate.py"]),
    Gate(["python3", "scripts/checks/checked_terminology_gate.py"]),
    Gate(["python3", "scripts/checks/plugin_provenance_doctor.py"]),
    Gate(["python3", "scripts/checks/doc_claims_gate.py"]),
    Gate(["python3", "scripts/checks/doc_link_targets.py"]),
    Gate(["python3", "scripts/checks/doc_cited_paths.py"]),
    Gate(["python3", "scripts/checks/control_plane_actor_gate.py"]),
    # a docs-only diff provably cannot change packaging, so the wheel gate is skipped
    Gate(["python3", "scripts/checks/wheel_gate.py"], docs=False, shard="runtime"),
    Gate(_pytest_cmd(CONTRACT_MARKERS), shard="contract", markers=CONTRACT_MARKERS),
    Gate(_pytest_cmd(RUNTIME_MARKERS), shard="runtime", markers=RUNTIME_MARKERS),
    Gate(_pytest_cmd(SWEEP_MARKERS), shard="sweep", markers=SWEEP_MARKERS),
    Gate(
        ["python3", "scripts/test_vault/e2e_smoke.py"],
        docs=False,
        shard="runtime",
        mutates_vault=True,
    ),
    Gate(
        [
            "python3",
            "-m",
            "compileall",
            "-q",
            "src/memoria_vault",
            "scripts/checks",
            "scripts/test_vault",
            "scripts/verify",
        ],
        docs=False,
    ),
    # 1689: the installed console script is the one surface no other gate
    # exercises through PATH — pytest resolves src/ via path config, so a
    # stale editable install (e.g. pointing at a deleted worktree) keeps
    # every gate green while `memoria` is dead for every CLI-consuming task.
    Gate(["memoria", "--version"], docs=False),
]

# Self-skips when the analyzer module is absent (exit 2), so a machine with pwsh
# but no PSScriptAnalyzer does not hard-fail the gate. Enumerates from git rather
# than naming a path: the shellcheck hook shipped an exact-path form that lint-ed
# one of four scripts, and a literal here is the same failure waiting for a
# second .ps1.
PSSA_COMMAND = (
    "if (-not (Get-Module -ListAvailable -Name PSScriptAnalyzer)) "
    "{ Write-Host 'PSScriptAnalyzer module not installed'; exit 2 }; "
    "$files = git ls-files '*.ps1'; "
    "if (-not $files) { exit 0 }; "
    "$r = Invoke-ScriptAnalyzer -Path $files -Severity Warning,Error "
    "-Settings ./scripts/PSScriptAnalyzerSettings.psd1; "
    "if ($r) { $r | Format-Table -AutoSize; exit 1 }"
)


def _selected(shard: str | None) -> list[Gate]:
    """The gates one run owns. `shard=None` — the local default — owns them all."""
    return [gate for gate in GATES if shard is None or gate.shard == shard]


def _needs_vault_lock(shard: str | None) -> bool:
    """Whether this selection touches `<checkout>/test-vault`, so must serialize."""
    return any(gate.mutates_vault for gate in _selected(shard))


def _gates_for_run(docs_only: bool, shard: str | None = None) -> list[list[str]]:
    """The roster, narrowed to one shard and/or to the docs-relevant subset.

    An empty result is a legitimate outcome, not an error: CI invokes every shard
    on a docs-only PR, and the shards holding no docs-relevant gate simply pass.
    """
    selected = _selected(shard)
    if not docs_only:
        return [gate.cmd for gate in selected]
    reduced: list[list[str]] = []
    for gate in selected:
        if gate.manual_lint:
            reduced.extend(list(command) for command in DOCS_LINT_COMMANDS)
            continue
        if not gate.docs:
            continue
        if gate.markers is None:
            reduced.append(gate.cmd)
            continue
        # Under a docs-only diff only the shard whose markers already contain
        # `static` runs tests, narrowed to it. Letting every test shard narrow to
        # `static` would run the same set three times for no added coverage.
        if "static" not in gate.markers:
            continue
        reduced.append(["static" if arg == gate.markers else arg for arg in gate.cmd])
    return reduced


def _hold_single_run_lock(path: Path = LOCK_PATH) -> object | None:
    """Take this checkout's gate lock, or exit saying who already holds it.

    `scripts/test_vault/e2e_smoke.py` resets `<checkout>/test-vault` outright at
    its stage, so two gates in one checkout wipe each other's fixture mid-run
    and neither result means anything. The lock is per-checkout rather than
    global because #1568 deliberately made each worktree own its vault, and
    running the gate in several worktrees at once is the point of having them.

    flock is released by the kernel when the holder dies, so a killed run leaves
    no stale lock to clear by hand. The returned handle must stay referenced for
    the lifetime of the run; closing it releases the lock.
    """
    try:
        import fcntl
    except ImportError:  # no flock off POSIX; the gate simply goes unguarded
        return None
    # "a+" so a waiting run can read the holder's pid without truncating it.
    handle = path.open("a+", encoding="utf-8")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        handle.seek(0)
        holder = handle.read().strip() or "unknown"
        handle.close()
        print(f"verify: already running in this checkout (pid {holder})", file=sys.stderr)
        raise SystemExit(1) from None
    handle.seek(0)
    handle.truncate()
    handle.write(str(os.getpid()))
    handle.flush()
    return handle


def run(command: list[str]) -> int:
    print(f"== {' '.join(command)}")
    start = time.perf_counter()
    try:
        code = subprocess.run(command, cwd=ROOT, check=False).returncode
        print(f"   step time: {time.perf_counter() - start:.1f}s")
        return code
    except FileNotFoundError:
        # `check=False` swallows a nonzero exit, but not a missing executable --
        # that's exactly the failure the `memoria --version` gate exists to
        # catch (#1689), so it must report the same way every other gate
        # failure does rather than crash the whole run with a traceback.
        print(f"  command not found: {command[0]}", file=sys.stderr)
        return 127


def check_json() -> int:
    listing = subprocess.run(
        ["git", "ls-files", "*.json"],
        cwd=ROOT,
        text=True,
        capture_output=True,
        check=False,
    )
    bad: list[str] = []
    for name in listing.stdout.splitlines():
        try:
            json.loads((ROOT / name).read_text(encoding="utf-8"))
        except (ValueError, OSError) as exc:
            bad.append(f"{name}: {exc}")
    print("== authored JSON syntax")
    for entry in bad:
        print(f"  invalid JSON: {entry}")
    return 1 if bad else 0


def check_powershell() -> int:
    print("== PSScriptAnalyzer (tracked *.ps1)")
    if shutil.which("pwsh") is None:
        print("  skipped: pwsh not installed")
        return 0
    code = subprocess.run(
        ["pwsh", "-NoProfile", "-Command", PSSA_COMMAND],
        cwd=ROOT,
        check=False,
    ).returncode
    if code == 2:
        print("  skipped: PSScriptAnalyzer module not installed")
        return 0
    return code


# The native steps, which are Python rather than a subprocess roster. Keyed by
# shard so the same partition rule that covers GATES covers them too.
EXTRA_STEPS: dict[str, tuple] = {"lint": (check_json, check_powershell)}


def _extra_steps_for_run(docs_only: bool, shard: str | None) -> tuple:
    """The JSON and PowerShell syntax checks test code/config, not documentation."""
    if docs_only:
        return ()
    if shard is None:
        return tuple(step for steps in EXTRA_STEPS.values() for step in steps)
    return EXTRA_STEPS.get(shard, ())


def _parse_shard(argv: list[str]) -> str | None:
    """`--shard NAME`, or None for the full roster.

    An unknown name is an error rather than an empty run: a typo in the CI matrix
    would otherwise report a green shard that ran nothing.
    """
    if "--shard" not in argv:
        return None
    index = argv.index("--shard")
    if index + 1 >= len(argv):
        raise SystemExit("verify: --shard needs a name")
    shard = argv[index + 1]
    if shard not in SHARDS:
        raise SystemExit(f"verify: unknown shard {shard!r}; expected one of {', '.join(SHARDS)}")
    return shard


def main(argv: list[str] | None = None) -> int:
    shard = _parse_shard(sys.argv[1:] if argv is None else argv)
    # Only a selection that rewrites <checkout>/test-vault needs to serialize, so
    # the other shards can run beside it in one checkout.
    _lock = _hold_single_run_lock() if _needs_vault_lock(shard) else None
    run_start = time.perf_counter()
    if shard is not None:
        print(f"== verify: shard {shard}")
    if DOCS_ONLY:
        print(
            "== verify: docs-only scope — lint, the docs-relevant product gates, and static tests"
        )
    for command in _gates_for_run(DOCS_ONLY, shard):
        if run(command) != 0:
            print("verify: FAILED", file=sys.stderr)
            return 1
    for step in _extra_steps_for_run(DOCS_ONLY, shard):
        step_start = time.perf_counter()
        code = step()
        print(f"   step time: {time.perf_counter() - step_start:.1f}s")
        if code != 0:
            print("verify: FAILED", file=sys.stderr)
            return 1
    print(f"verify: total {time.perf_counter() - run_start:.1f}s")
    print("verify: OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
